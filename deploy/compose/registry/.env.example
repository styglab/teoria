TEORIA_IMAGE_REGISTRY_TLS_CERT=/secure/registry/tls.crt
TEORIA_IMAGE_REGISTRY_TLS_KEY=/secure/registry/tls.key
TEORIA_IMAGE_REGISTRY_BIND=0.0.0.0
TEORIA_IMAGE_REGISTRY_PORT=5000
