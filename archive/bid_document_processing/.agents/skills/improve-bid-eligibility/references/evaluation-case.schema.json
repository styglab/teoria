{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "partition", "notice", "provenance", "expected", "classification"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "partition": {"enum": ["discovery", "regression", "holdout"]},
    "notice": {
      "type": "object",
      "required": ["notice_number", "notice_order"],
      "properties": {
        "notice_number": {"type": "string"},
        "notice_order": {"type": "string"},
        "work_type": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sampled_at", "input_fingerprint", "versions", "expectation_method"],
      "properties": {
        "sampled_at": {"type": "string", "format": "date-time"},
        "input_fingerprint": {"type": "string", "minLength": 1},
        "versions": {"type": "object"},
        "expectation_method": {"const": "independent_source_review"},
        "document_checksums": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "expected": {
      "type": "object",
      "required": ["requirements", "unresolved_candidates"],
      "properties": {
        "requirements": {"type": "array", "items": {"type": "object"}},
        "participation_findings": {"type": "array", "items": {"type": "object"}},
        "unresolved_candidates": {"type": "array", "items": {"type": "object"}},
        "expression": {"type": "object"},
        "adjudication_required": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": ["earliest_layer", "severity"],
      "properties": {
        "earliest_layer": {"enum": ["acquisition", "parsing", "selection", "extraction", "normalization", "expression", "persistence", "none"]},
        "severity": {"enum": ["critical", "major", "minor", "none"]},
        "error_codes": {"type": "array", "items": {"type": "string"}},
        "adjudication_note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
