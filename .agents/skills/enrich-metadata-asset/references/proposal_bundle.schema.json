{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceInput": {
      "properties": {
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "evidence_type",
        "source_ref"
      ],
      "title": "EvidenceInput",
      "type": "object",
      "additionalProperties": false
    }
  },
  "title": "Teoria metadata proposal bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "suggestions"
  ],
  "properties": {
    "bundle_version": {
      "const": "1.0"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "properties": {
          "target_type": {
            "enum": [
              "openmetadata_table",
              "openmetadata_column",
              "openmetadata_glossary",
              "ontology"
            ],
            "title": "Target Type",
            "type": "string"
          },
          "target_ref": {
            "title": "Target Ref",
            "type": "string"
          },
          "suggestion_type": {
            "enum": [
              "description",
              "binding",
              "glossary_term",
              "glossary_term_assignment"
            ],
            "title": "Suggestion Type",
            "type": "string"
          },
          "proposed_value": {
            "additionalProperties": true,
            "title": "Proposed Value",
            "type": "object"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rationale"
          },
          "risk_level": {
            "default": "low",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Level",
            "type": "string"
          },
          "model_provider": {
            "title": "Model Provider",
            "type": "string",
            "minLength": 1
          },
          "model_name": {
            "title": "Model Name",
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Version"
          },
          "policy_version": {
            "const": "metadata-asset-analysis-v1"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/EvidenceInput"
            },
            "title": "Evidence",
            "type": "array",
            "minItems": 1
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "target_type",
          "target_ref",
          "suggestion_type",
          "proposed_value",
          "confidence",
          "risk_level",
          "model_provider",
          "model_name",
          "policy_version",
          "evidence"
        ],
        "title": "Metadata proposal",
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "target_type": {
                  "const": "openmetadata_table"
                }
              }
            },
            "then": {
              "properties": {
                "target_ref": {
                  "pattern": "^openmetadata://table/.+"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_type": {
                  "const": "openmetadata_column"
                }
              }
            },
            "then": {
              "properties": {
                "target_ref": {
                  "pattern": "^openmetadata://column/.+"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_type": {
                  "const": "openmetadata_glossary"
                }
              }
            },
            "then": {
              "properties": {
                "target_ref": {
                  "pattern": "^openmetadata://glossary/.+"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_type": {
                  "const": "ontology"
                }
              }
            },
            "then": {
              "properties": {
                "target_ref": {
                  "pattern": "^teoria://ontology/.+"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "suggestion_type": {
                  "const": "description"
                },
                "target_type": {
                  "const": "openmetadata_column"
                }
              }
            },
            "then": {
              "properties": {
                "proposed_value": {
                  "required": [
                    "description",
                    "table_id",
                    "column_name",
                    "column_fqn",
                    "source_version",
                    "source_description"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
