# Optional Docker-host execution inputs. local.sh reads k3d.env without shell evaluation.
# Empty values retain local.sh defaults. Shell environment overrides these values.
TEORIA_K3D_DATA_DIR=
TEORIA_K3D_KUBECONFIG=
TEORIA_K3D_API_SERVER=
TEORIA_K3D_HTTP_PORT=8080
TEORIA_K3D_HTTPS_PORT=8443
TEORIA_K3D_REVISION=
