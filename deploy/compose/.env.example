# Local Compose and repository development settings
TEORIA_ENVIRONMENT=development
TEORIA_REGISTRY_PATH=platform/registries
TEORIA_PIPELINE_PATH=pipelines
TEORIA_PLATFORM_REGISTRY_PATH=platform/registries
TEORIA_LOG_LEVEL=INFO
TEORIA_HTTP_PORT=8081
TEORIA_SOURCE_TIMEOUT_SECONDS=15
TEORIA_SOURCE_MAX_ATTEMPTS=3
TEORIA_SOURCE_MAX_PAGES=100
TEORIA_CAPABILITY_TIMEOUT_SECONDS=120
TEORIA_RUNTIME_API_TOKEN=
TEORIA_RUNTIME_API_ROOT_PATH=
TEORIA_ADMIN_API_ROOT_PATH=
TEORIA_ADMIN_AUTH_MODE=disabled
TEORIA_ADMIN_API_TOKEN=
TEORIA_ADMIN_API_ACTOR=system:admin
TEORIA_ADMIN_API_ROLES=metadata_admin,metadata_reviewer,binding_reviewer,ontology_owner
TEORIA_APP_DATABASE_URL=
TEORIA_OPENMETADATA_ENABLED=false
TEORIA_OPENMETADATA_BASE_URL=http://localhost:8585/api
TEORIA_OPENMETADATA_AUTH_TOKEN=
TEORIA_OPENMETADATA_TIMEOUT_SECONDS=10
TEORIA_OPENMETADATA_VERIFY_SSL=true
TEORIA_OPENMETADATA_DATABASE_SERVICE=teoria_postgresql
TEORIA_METADATA_DB_PASSWORD=teoria_local_metadata
OPENMETADATA_VERSION=1.12.6
OPENMETADATA_DB_PASSWORD=openmetadata_local
OPENMETADATA_INGESTION_BOT_TOKEN=
TEORIA_RUNTIME_DATA_DATABASE_URL=
TEORIA_MCP_RUNTIME_MODE=remote
TEORIA_MCP_RUNTIME_API_URL=
TEORIA_MCP_RUNTIME_API_TOKEN=
TEORIA_MCP_RUNTIME_TIMEOUT_SECONDS=150
TEORIA_PIPELINE_SOURCE_TIMEOUT_SECONDS=30
TEORIA_PIPELINE_SOURCE_MAX_ATTEMPTS=5
TEORIA_PIPELINE_SOURCE_RETRY_BACKOFF_SECONDS=60
TEORIA_PIPELINE_CONTRACT_REQUESTS_PER_SECOND=0.5
TEORIA_PIPELINE_BID_NOTICE_ENRICHMENT_REQUESTS_PER_SECOND=1
TEORIA_PIPELINE_BID_DOCUMENT_MAX_ATTEMPTS=3
TEORIA_PIPELINE_BID_DOCUMENT_PARSE_MAX_ATTEMPTS=3
TEORIA_PIPELINE_BID_DOCUMENT_RETENTION_DAYS=90
TEORIA_PIPELINE_BID_DOCUMENT_PURGE_BATCH_SIZE=500
TEORIA_PREFECT_USERNAME=
TEORIA_PREFECT_PASSWORD=
# source api key
TEORIA_SOURCE_FSC_COMPANY_BASIC_API_KEY=
TEORIA_SOURCE_FSC_COMPANY_FINANCIAL_API_KEY=
TEORIA_SOURCE_NTS_BUSINESS_REGISTRATION_API_KEY=
TEORIA_SOURCE_PPS_USER_API_KEY=
TEORIA_CONNECTOR_PPS_INDUSTRY_API_KEY=
TEORIA_SOURCE_KODMA_SMPP_CERTIFICATE_API_KEY=
TEORIA_CONNECTOR_PPS_CONTRACT_API_KEY=
TEORIA_CONNECTOR_PPS_BID_RESULT_API_KEY=
TEORIA_CONNECTOR_PPS_BID_NOTICE_API_KEY=
TEORIA_PIPELINE_DATA_DATABASE_URL=
TEORIA_OBJECT_STORAGE_ENDPOINT=https://minio.example.com
TEORIA_OBJECT_STORAGE_ACCESS_KEY=
TEORIA_OBJECT_STORAGE_SECRET_KEY=
TEORIA_OBJECT_STORAGE_BUCKET=teoria
TEORIA_CODEX_MODEL=gpt-5.6-sol
TEORIA_CODEX_FALLBACK_MODEL=gpt-5.6-terra
TEORIA_CODEX_EXECUTION_TIMEOUT_SECONDS=600
# 참가자격 추출은 코드·인용 후처리가 있으므로 낮은 추론 강도를 기본 사용한다.
TEORIA_PIPELINE_BID_ELIGIBILITY_INPUT_MAX_CHARS=30000
# local Compose only; use managed secrets outside local development
TEORIA_LOCAL_DATA_DB_PASSWORD=teoria_local_data
# superuser for the shared Control/Application PostgreSQL instance
TEORIA_LOCAL_PLATFORM_DB_PASSWORD=platform_local
TEORIA_LOCAL_APP_DB_PASSWORD=teoria_local_app
TEORIA_LOCAL_RUNTIME_DB_PASSWORD=
TEORIA_LOCAL_PREFECT_DB_PASSWORD=prefect_local
