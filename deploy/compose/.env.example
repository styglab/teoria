# 복사: cp deploy/compose/.env.example deploy/compose/.env
# 공통 필수와 선택한 모듈의 필수값만 입력하고, 사용하지 않는 모듈 구간은 삭제한다.
# 선택 설정은 주석 상태에서 Compose 기본값을 사용한다. 바꿀 항목만 주석을 해제한다.
# 실제 비밀값은 Git에 저장하지 않는다. 자세한 설명: docs/deployment/configuration.md
# DB의 기존 계정·암호와 검증한 이미지 태그는 재배포 시 유지한다.
# 컨테이너 내부 경로·정책은 compose*.yaml이 소유한다.

# 공통 필수 — 모든 배포에서 입력
TEORIA_ADMIN_API_TOKEN=
TEORIA_PREFECT_USERNAME=
TEORIA_PREFECT_PASSWORD=
TEORIA_MINIO_ROOT_USER=
TEORIA_MINIO_ROOT_PASSWORD=

# Semantic·FormatID 공통 필수 — 둘 중 하나를 사용하면 입력
TEORIA_LOCAL_RUNTIME_DB_PASSWORD=
TEORIA_OPA_CONTROL_PLANE_TOKEN=

# Semantic 필수 — --modules semantic 사용 시 입력
TEORIA_RUNTIME_API_TOKEN=
TEORIA_CONNECTOR_MOLEG_LAW_API_KEY=

# FormatID 필수 — --modules formatid 사용 시 입력
TEORIA_SPECIFICATION_WORKER_STORAGE_SECRET_KEY=
TEORIA_SPECIFICATION_API_STORAGE_SECRET_KEY=

# MLOps 필수 — --modules mlops 사용 시 입력하고 인증 파일 준비
# URL은 플랫폼 내부 주소, PUBLIC_HOST·허용 목록은 Docker 클라이언트의 host[:port] 형식.
# 인증 파일의 기본 위치는 아래 MLOps 선택 구간을 참고한다.
TEORIA_MLFLOW_DB_PASSWORD=
TEORIA_IMAGE_REGISTRY_HTTP_SECRET=
TEORIA_IMAGE_REGISTRY_URL=http://image-registry:5000
TEORIA_IMAGE_REGISTRY_PUBLIC_HOST=localhost:8081
TEORIA_IMAGE_REGISTRY_USERNAME=
TEORIA_IMAGE_REGISTRY_PASSWORD=
# 외부 HTTPS Registry에 별도 CA가 필요한 경우에만 설정한다.
# TEORIA_IMAGE_REGISTRY_CA_PEM=
TEORIA_MODEL_ALLOWED_REGISTRIES=localhost:8081

# 공통 선택 — 공개 포트·릴리스 이미지·계정 기본값을 변경할 때만 해제
# TEORIA_HTTP_PORT=8081
# 로컬 이미지는 prefix 없이 teoria-*를 사용한다. 외부 Registry·조직 경로가 있을 때만 설정한다.
# TEORIA_IMAGE_PREFIX=
# 현재 Teoria 버전. 실행 모듈이나 로컬 여부와 무관하게 같은 태그를 사용한다.
TEORIA_IMAGE_TAG=0.1.0
# 기존 공통 저장소를 다른 Compose 프로젝트에서 재사용할 때만 지정한다.
# TEORIA_STORAGE_VOLUMES_EXTERNAL=false
# TEORIA_PLATFORM_DB_VOLUME_NAME=
# TEORIA_PREFECT_REDIS_VOLUME_NAME=
# TEORIA_MODEL_OBJECTS_VOLUME_NAME=
# TEORIA_ADMIN_API_IMAGE=
# TEORIA_ADMIN_API_ACTOR=system:admin
# TEORIA_ADMIN_API_ROLES=metadata_admin,metadata_reviewer,binding_reviewer,ontology_owner
# TEORIA_ADMIN_METADATA_PUBLIC_READ=false
# TEORIA_LOCAL_PLATFORM_DB_PASSWORD=platform_local
# TEORIA_LOCAL_APP_DB_PASSWORD=teoria_local_app
# TEORIA_LOCAL_PREFECT_DB_PASSWORD=prefect_local
# TEORIA_MINIO_BROWSER_REDIRECT_URL=http://localhost:8081/minio/

# Semantic 선택 — Metadata 연결·진단·이미지 기본값 변경
# OpenMetadata token은 실제 인스턴스의 인증 설정에 맞춰 지정한다. 진단은 기본 비활성.
# TEORIA_RUNTIME_API_IMAGE=
# TEORIA_ASSESSMENT_WORKER_IMAGE=
# OPENMETADATA_VERSION=2.0.5
# OPENMETADATA_DB_PASSWORD=openmetadata_local
# OPENMETADATA_INGESTION_BOT_TOKEN=
# TEORIA_OPENMETADATA_ENABLED=true
# TEORIA_OPENMETADATA_BASE_URL=http://openmetadata-server:8585/api
# TEORIA_OPENMETADATA_AUTH_TOKEN=
# TEORIA_OPENMETADATA_DATABASE_SERVICE=teoria_postgresql
# TEORIA_METADATA_DB_PASSWORD=teoria_local_metadata
# TEORIA_OPENMETADATA_INGESTION_CPUS=1
# TEORIA_OPENMETADATA_INGESTION_MEMORY=2g
# TEORIA_ASSESSMENT_ENABLED=false
# TEORIA_ASSESSMENT_CODEX_MODEL=
# TEORIA_ASSESSMENT_CODEX_TIMEOUT_SECONDS=180
# TEORIA_ASSESSMENT_LAW_MAX_DOCUMENTS=5
# TEORIA_ASSESSMENT_LAW_MAX_CHARS=12000

# Semantic·FormatID 선택 — Data DB·정책 기본값 변경
# TEORIA_LOCAL_DATA_DB_PASSWORD=teoria_local_data
# TEORIA_PIPELINE_DATA_DATABASE_URL=
# TEORIA_RUNTIME_DATA_DATABASE_URL=
# TEORIA_OPA_BUNDLE_REVISION=development

# FormatID 선택 — 저장소·작성 API·Worker 이미지 기본값 변경
# AUTHORING_API_TOKEN을 생략하면 공통 Admin 토큰을 사용한다.
# TEORIA_SPECIFICATION_WORKER_IMAGE=
# TEORIA_SPECIFICATION_ARTIFACT_ROOT=s3://teoria-artifacts
# TEORIA_SPECIFICATION_S3_ENDPOINT=http://minio:9000
# TEORIA_SPECIFICATION_WORKER_STORAGE_ACCESS_KEY=teoria_specification_worker
# TEORIA_SPECIFICATION_API_STORAGE_ACCESS_KEY=teoria_specification_api
# TEORIA_SPECIFICATION_AUTHORING_API_URL=http://admin-api:8001
# TEORIA_SPECIFICATION_AUTHORING_API_TOKEN=

# MLOps 선택 — Registry 경로·모델 실행 기본값 변경
# TEORIA_DOCKER_CONFIG_DIRECTORY=./docker_auth
# TEORIA_IMAGE_REGISTRY_CONFIG_FILE=
TEORIA_IMAGE_REGISTRY_AUTH_FILE=/secure/teoria-registry/htpasswd
# TEORIA_IMAGE_REGISTRY_VOLUME_NAME=
# TEORIA_MODEL_S3_ENDPOINT=http://minio:9000
# TEORIA_MODEL_WORKLOAD_ENVIRONMENT={}

# 선택 — 공식 이미지에 접근할 수 없을 때 검증한 OCI 빌드 캐시 지정
# TEORIA_MINIO_MC_BUILD_CONTEXT=
# TEORIA_OPENMETADATA_INGESTION_BUILD_CONTEXT=

# 선택 — 처리량·자원·재시도 기본값 변경
# TEORIA_DATABASE_CONCURRENCY_LIMIT=10
# TEORIA_MCP_RUNTIME_TIMEOUT_SECONDS=150
# TEORIA_MCP_RUNTIME_MAX_ATTEMPTS=3
# TEORIA_MCP_RUNTIME_RETRY_BACKOFF_SECONDS=0.25
# TEORIA_PIPELINE_SOURCE_TIMEOUT_SECONDS=30
# TEORIA_PIPELINE_CONCURRENCY=2
# TEORIA_PIPELINE_WORKER_CPUS=4
# TEORIA_PIPELINE_WORKER_MEMORY=8g
# TEORIA_PIPELINE_SOURCE_MAX_ATTEMPTS=5
# TEORIA_PIPELINE_SOURCE_RETRY_BACKOFF_SECONDS=60
# TEORIA_PIPELINE_DATABASE_CONCURRENCY_LIMIT=10
