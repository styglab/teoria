# Development credentials only. Never reuse production credentials.
# Create Secret model-workload in namespace teoria-models; keep actual workload.env private.
# Use a dedicated account limited to training inputs and model outputs, not MinIO admin.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_ENDPOINT_URL_S3=http://minio.teoria.svc:9000
MLFLOW_S3_ENDPOINT_URL=http://minio.teoria.svc:9000
