TEORIA_LOCAL_DATA_DB_PASSWORD=CHANGE_ME
TEORIA_LOCAL_PLATFORM_DB_PASSWORD=CHANGE_ME
TEORIA_LOCAL_PREFECT_DB_PASSWORD=CHANGE_ME
TEORIA_LOCAL_RUNTIME_DB_PASSWORD=CHANGE_ME
TEORIA_METADATA_DB_PASSWORD=CHANGE_ME
TEORIA_OPA_CONTROL_PLANE_TOKEN=CHANGE_ME
