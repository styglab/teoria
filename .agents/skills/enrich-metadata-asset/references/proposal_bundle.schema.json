{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teoria metadata proposal bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "suggestions"],
  "properties": {
    "bundle_version": {"const": "1.0"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_type", "target_ref", "suggestion_type", "proposed_value", "confidence", "risk_level", "model_provider", "model_name", "policy_version", "evidence"],
        "properties": {
          "target_type": {"enum": ["openmetadata_table", "openmetadata_column", "openmetadata_glossary", "ontology"]},
          "target_ref": {"type": "string", "pattern": "^(openmetadata://(table|column|glossary)/|teoria://ontology/).+"},
          "suggestion_type": {"enum": ["description", "binding", "glossary_term", "glossary_term_assignment"]},
          "proposed_value": {"type": "object"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": ["string", "null"]},
          "risk_level": {"enum": ["low", "medium", "high"]},
          "model_provider": {"type": "string", "minLength": 1},
          "model_name": {"type": "string", "minLength": 1},
          "model_version": {"type": ["string", "null"]},
          "policy_version": {"const": "metadata-asset-analysis-v1"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_type", "source_ref"],
              "properties": {
                "evidence_type": {"type": "string", "minLength": 1},
                "source_ref": {"type": "string", "minLength": 1},
                "excerpt": {"type": ["string", "null"]},
                "content_hash": {"type": ["string", "null"]},
                "observed_at": {"type": ["string", "null"], "format": "date-time"},
                "provenance": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
