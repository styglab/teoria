# Docker Compose interpolation inputs. Copy to deploy/compose/.env.
# Container-internal paths, URLs and production policy are owned by compose.yaml.
# Host-run application settings are documented in docs/deployment/configuration.md.
TEORIA_HTTP_PORT=8081
TEORIA_RUNTIME_API_TOKEN=
TEORIA_OPA_CONTROL_PLANE_TOKEN=
TEORIA_OPA_BUNDLE_REVISION=development
TEORIA_ADMIN_METADATA_PUBLIC_READ=false
TEORIA_ADMIN_API_TOKEN=
TEORIA_ADMIN_API_ACTOR=system:admin
TEORIA_ADMIN_API_ROLES=metadata_admin,metadata_reviewer,binding_reviewer,ontology_owner
TEORIA_OPENMETADATA_ENABLED=true
TEORIA_OPENMETADATA_BASE_URL=http://openmetadata-server:8585/api
TEORIA_OPENMETADATA_AUTH_TOKEN=
TEORIA_OPENMETADATA_DATABASE_SERVICE=teoria_postgresql
TEORIA_METADATA_DB_PASSWORD=teoria_local_metadata
OPENMETADATA_VERSION=2.0.5
OPENMETADATA_DB_PASSWORD=openmetadata_local
OPENMETADATA_INGESTION_BOT_TOKEN=
TEORIA_OPENMETADATA_INGESTION_CPUS=1
TEORIA_OPENMETADATA_INGESTION_MEMORY=2g
TEORIA_RUNTIME_DATA_DATABASE_URL=
TEORIA_DATABASE_CONCURRENCY_LIMIT=10
TEORIA_MCP_RUNTIME_TIMEOUT_SECONDS=150
TEORIA_MCP_RUNTIME_MAX_ATTEMPTS=3
TEORIA_MCP_RUNTIME_RETRY_BACKOFF_SECONDS=0.25
TEORIA_PIPELINE_SOURCE_TIMEOUT_SECONDS=30
TEORIA_PIPELINE_CONCURRENCY=2
TEORIA_PIPELINE_WORKER_CPUS=4
TEORIA_PIPELINE_WORKER_MEMORY=8g
TEORIA_PIPELINE_SOURCE_MAX_ATTEMPTS=5
TEORIA_PIPELINE_SOURCE_RETRY_BACKOFF_SECONDS=60
TEORIA_PREFECT_USERNAME=
TEORIA_PREFECT_PASSWORD=
TEORIA_PIPELINE_DATA_DATABASE_URL=
TEORIA_PIPELINE_DATABASE_CONCURRENCY_LIMIT=10
# local Compose only; use managed secrets outside local development
TEORIA_LOCAL_DATA_DB_PASSWORD=teoria_local_data
# superuser for the shared Control/Application PostgreSQL instance
TEORIA_LOCAL_PLATFORM_DB_PASSWORD=platform_local
TEORIA_LOCAL_APP_DB_PASSWORD=teoria_local_app
TEORIA_LOCAL_RUNTIME_DB_PASSWORD=
TEORIA_LOCAL_PREFECT_DB_PASSWORD=prefect_local

# Optional on-demand asset diagnosis. Start with --profile intelligence.
TEORIA_ASSESSMENT_ENABLED=false
# Full HTTP chat-completions gateway endpoint; no endpoint is selected implicitly.
TEORIA_ASSESSMENT_MODEL_URL=
TEORIA_ASSESSMENT_MODEL_NAME=
TEORIA_ASSESSMENT_MODEL_TOKEN=
TEORIA_ASSESSMENT_MODEL_TIMEOUT_SECONDS=90
TEORIA_ASSESSMENT_MODEL_MAX_TOKENS=6000

# Law collection only; injected into the dedicated law worker.
TEORIA_CONNECTOR_MOLEG_LAW_API_KEY=

# Standard workflow: internal Platform authoring API (never Runtime).
TEORIA_SPECIFICATION_AUTHORING_API_URL=http://admin-api:8001
# Leave empty to use the configured local Admin token; use a separately provisioned credential when supported by the target API.
TEORIA_SPECIFICATION_AUTHORING_API_TOKEN=

# Optional synthetic MLOps demo: enable profiles mlops,object-storage,model-serving.
TEORIA_MODEL_OPERATIONS_ENABLED=false
TEORIA_MLFLOW_DB_PASSWORD=
TEORIA_MINIO_ACCESS_KEY=
TEORIA_MINIO_SECRET_KEY=
TEORIA_DEMO_INFERENCE_TOKEN=
# Set to an external S3-compatible endpoint when not running local MinIO.
TEORIA_MODEL_S3_ENDPOINT=http://minio:9000

# Bound law evidence for the configured diagnosis model context window.
TEORIA_ASSESSMENT_LAW_MAX_DOCUMENTS=5
TEORIA_ASSESSMENT_LAW_MAX_CHARS=12000

# Optional image override for the specification Worker only.
TEORIA_SPECIFICATION_WORKER_IMAGE=teoria-pipelines:latest
# Optional image override for Admin HTTP only; other authoring roles keep their own image.
TEORIA_ADMIN_API_IMAGE=teoria-platform-authoring:latest
