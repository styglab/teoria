# Production connections; copy to connections.env and register explicitly.
# Non-secret service endpoints; create ConfigMap teoria-mlops-connections.
TEORIA_ENVIRONMENT=production
PREFECT_API_URL=http://prefect-server.teoria.svc:4200/api
MLFLOW_TRACKING_URI=http://mlflow.teoria.svc:5000/mlflow
TEORIA_MODEL_STORAGE_ENDPOINT=http://minio.teoria.svc:9000
TEORIA_OPENMETADATA_BASE_URL=http://openmetadata-server.teoria.svc:8585/api
# Enable only after the existing Teoria Data PostgreSQL source and ingestion bot are configured.
TEORIA_METADATA_SYNC_SCHEDULE_ENABLED=false
# Domain API, worker and schedule activation is independent of platform installation.
TEORIA_SPECIFICATION_PROCESSING_ENABLED=false
TEORIA_LEGAL_INFORMATION_ENABLED=false
# Browser URL is independent of the internal API; blank hides the console link.
TEORIA_OPENMETADATA_PUBLIC_URL=
# Requires processing enabled and a verified S3 bucket/credentials.
TEORIA_SPECIFICATION_UPLOAD_ENABLED=false
