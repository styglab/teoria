# Secret specification-processing in namespace teoria. Never reuse the Admin token or MinIO root user.
# Its service identity may call only the workflow routes declared by goods/authoring_client.py.
TEORIA_SPECIFICATION_AUTHORING_API_URL=http://admin-api.teoria.svc:8001
TEORIA_SPECIFICATION_AUTHORING_API_TOKEN=CHANGE_ME
TEORIA_SPECIFICATION_ARTIFACT_ROOT=s3://teoria-artifacts
TEORIA_SPECIFICATION_S3_ENDPOINT=http://minio.teoria.svc:9000
TEORIA_SPECIFICATION_S3_ACCESS_KEY=CHANGE_ME
TEORIA_SPECIFICATION_S3_SECRET_KEY=CHANGE_ME
