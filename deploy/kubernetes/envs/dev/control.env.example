# Development credentials only. Never reuse production credentials.
# Create Secret model-control in namespace teoria; keep actual control.env private.
TEORIA_MLFLOW_DB_PASSWORD=CHANGE_ME
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlflow:CHANGE_ME@platform-postgres:5432/mlflow
TEORIA_MODEL_ALLOWED_REGISTRIES=harbor.teoria.localhost

# Controller-only account: read training results and preserve workload logs.
TEORIA_MODEL_STORAGE_ACCESS_KEY=CHANGE_ME
TEORIA_MODEL_STORAGE_SECRET_KEY=CHANGE_ME
